{
  "name": "routy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=26.12.1 <27"
  },
  "scripts": {
    "dev": "pnpm --filter @routy/web dev",
    "build": "pnpm build:web",
    "build:web": "pnpm --filter @routy/web build:web",
    "build:app": "pnpm --filter @routy/web build:app",
    "start": "pnpm --filter @routy/web start",
    "lint": "pnpm --filter @routy/web lint",
    "typecheck": "pnpm --filter @routy/contracts typecheck && pnpm --filter @routy/web typecheck",
    "contracts:generate": "pnpm --filter @routy/contracts generate",
    "db:validate": "pnpm --filter @routy/web db:validate",
    "dev:up": "docker compose -f compose.dev.yaml up -d --build",
    "dev:down": "docker compose -f compose.dev.yaml down",
    "prod:up": "docker compose --env-file .env.prod -f compose.prod.yaml up -d --build",
    "prod:down": "docker compose --env-file .env.prod -f compose.prod.yaml down"
  },
  "author": {
    "name": "EoWoo",
    "url": "https://eowoo.org"
  },
  "homepage": "https://eowoo.org"
}
