{
  "name": "@routy/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0",
    "build": "pnpm build:web",
    "build:web": "node scripts/build-web.mjs",
    "build:app": "tsx scripts/build-capacitor-app.ts",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "cap:sync": "pnpm build:app && cap sync",
    "android:sync": "pnpm build:app && cap sync android",
    "ios:sync": "pnpm build:app && cap sync ios",
    "db:deploy": "prisma migrate deploy",
    "test:records": "tsx --test test/driving-records*.test.ts",
    "test:pairing": "tsx --test test/account-pairing.api.test.ts",
    "test:mobile-auth": "tsx --test test/account-client.test.ts test/account-mobile.api.test.ts",
    "test:account-deletion": "tsx --test test/account-deletion.api.test.ts",
    "test:navigation": "tsx --test test/navigation*.test.ts",
    "account:erasures": "tsx scripts/account-erasures.ts"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@aws-sdk/client-s3": "^3.1095.0",
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.1",
    "@capacitor/browser": "8.0.4",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/geolocation": "8.2.2",
    "@capacitor/ios": "8.6.0",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/push-notifications": "8.1.2",
    "@capacitor/share": "8.0.1",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@next/env": "16.2.6",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@react-pdf/renderer": "^4.9.0",
    "@routy/contracts": "workspace:*",
    "@tanstack/react-query": "^5.100.11",
    "exifr": "^7.1.3",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.28.0",
    "next": "16.2.6",
    "nodemailer": "^9.0.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.21.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "0.0.1",
    "sharp": "^0.34.5",
    "web-push": "^3.6.7",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.6.0",
    "@types/node": "^26",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prisma": "^7.8.0",
    "tsx": "^4.22.3",
    "typescript": "^5"
  },
  "author": {
    "name": "EoWoo",
    "url": "https://eowoo.org"
  },
  "homepage": "https://routy.eowoo.org"
}
