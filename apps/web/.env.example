# Local Next.js server and PostgreSQL. Copy to apps/web/.env.
DATABASE_URL="postgresql://routy:routy_local@localhost:5433/routy?schema=public"

# Web requests default to /api. For an app build, set the actual HTTPS API URL
# in .env.production.local or in the build environment. Do not use a placeholder URL.
# NEXT_PUBLIC_API_BASE_URL="https://eowoo.org/api"
